root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120
# Keep the codebase's one-parameter-per-line style for constructors with two or more parameters.
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2
# Start a multi-line expression body on the line after `=`, as the codebase already does.
ktlint_function_signature_body_expression_wrapping = multiline

